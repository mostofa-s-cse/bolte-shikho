generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

// Minimal view of Supabase Auth's users table — just enough to relate our
// own tables to it. The rest of the auth schema (sessions, identities, MFA,
// OAuth, etc.) is managed by Supabase itself and stays out of Prisma.
model users {
  id String @id @db.Uuid

  plan_day_completion plan_day_completion[]
  plan_start          plan_start?
  plan_task_progress  plan_task_progress[]
  practice_log        practice_log[]

  @@schema("auth")
}

model plan_day_completion {
  user_id        String   @db.Uuid
  plan_day       Int
  scheduled_date DateTime @db.Date
  completed_date DateTime @db.Date
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, plan_day])
  @@schema("public")
}

model plan_start {
  user_id    String   @id @db.Uuid
  start_date DateTime @db.Date
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model plan_task_progress {
  id           BigInt    @id @default(autoincrement())
  user_id      String    @db.Uuid
  plan_day     Int
  task_index   Int
  completed_at DateTime? @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, plan_day, task_index])
  @@schema("public")
}

model practice_log {
  user_id  String   @db.Uuid
  log_date DateTime @db.Date
  users    users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, log_date])
  @@schema("public")
}
