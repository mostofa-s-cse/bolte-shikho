NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Primary translation provider for /api/translate. Free key from
# https://aistudio.google.com/apikey — no billing account or card needed.
# Server-side only, never exposed to the client. OPTIONAL: without it the
# route falls back to the free unofficial Google Translate endpoint, so
# translation still works — just with lower quality and occasional
# rate-limiting. Free-tier caps are per model per day and are SMALL —
# gemini-3.6-flash reports a limit of 20/day. Check yours at
# https://aistudio.google.com/rate-limit. Past the quota the route falls
# back to the unofficial endpoint automatically.
GEMINI_API_KEY=your-gemini-api-key
# Optional — defaults to gemini-3.5-flash-lite (separate quota from the
# full flash models, same measured quality on Bengali).
# GEMINI_MODEL=gemini-3.5-flash-lite
