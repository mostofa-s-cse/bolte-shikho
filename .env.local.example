NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Azure AI Translator (Cognitive Services) — used by /api/translate.
# Create a free resource at https://portal.azure.com (Translator service,
# free F0 tier: 2M characters/month). Server-side only, never exposed to
# the client.
AZURE_TRANSLATOR_KEY=your-azure-translator-key
# Only required for a region-scoped resource (not a "Global" resource).
AZURE_TRANSLATOR_REGION=your-azure-region
