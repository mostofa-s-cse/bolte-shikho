NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Cloud Translation API — used by /api/translate.
# Create an API key at https://console.cloud.google.com (enable the
# "Cloud Translation API" on a project with billing enabled; free tier:
# 500,000 characters/month). Server-side only, never exposed to the client.
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key
