NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Primary translation provider for /api/translate. Free key from
# https://aistudio.google.com/apikey — no billing account or card needed.
# Server-side only, never exposed to the client. OPTIONAL: without it the
# route falls back to the free unofficial Google Translate endpoint, so
# translation still works — just with lower quality and occasional
# rate-limiting. Free tier has per-minute and per-day caps (see your own
# limits at https://aistudio.google.com/rate-limit); when the daily cap is
# hit, the route falls back to the unofficial endpoint automatically.
GEMINI_API_KEY=your-gemini-api-key
# Optional — defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
