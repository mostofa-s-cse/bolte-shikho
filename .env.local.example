NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backup translation provider — used by /api/translate ONLY when the
# primary (unofficial Google endpoint) fails. Free Hugging Face account,
# no card: https://huggingface.co/settings/tokens (create a token with
# "Inference Providers" permission). Server-side only, never exposed to
# the client. Optional — without it, a primary-provider failure returns a
# clear "busy, try again" error instead of using this fallback.
HUGGINGFACE_API_TOKEN=your-huggingface-api-token
